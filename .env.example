# ChargeShield Environment Configuration Template
# DISCLAIMER: Operating on explicit data provenance tracking (Production vs Simulation mode).

PROJECT_NAME=ChargeShield
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server & CORS Security
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT Authentication Security
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Payment Gateway Webhook Security
CHARGESHIELD_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET_IN_PRODUCTION

# Rate Limiting & Upload Hardening
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=10485760

# Evidence Document Storage Configuration
EVIDENCE_STORAGE_PATH=storage/evidence
EVIDENCE_MAX_FILE_SIZE_MB=10

# Explicit Development Seed Credentials (default SEED_DEV_USER=false)
SEED_DEV_USER=false
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=CHANGE_ME_PASSWORD

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./chargeshield.db
# DATABASE_URL=postgresql://chargeshield_user:password@localhost:5432/chargeshield_db

# LLM / Anthropic Claude API Key (Optional Agent Investigation)
ANTHROPIC_API_KEY=

# Frontend Base API URL
VITE_API_BASE_URL=http://127.0.0.1:8000
